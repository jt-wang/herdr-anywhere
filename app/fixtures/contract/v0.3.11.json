{
  "release": "v0.3.11",
  "source": "7b5d714791b861f638f2711f2203d4c9e7e6c761",
  "about": "Every route the v0.3.11 app calls, by the requests it sends (one or more samples a route, not every query it can build), as its app/src/link.ts, updates.ts and hc/ws.ts build them, what that app reads of each answer, and the v0.3.11 Companion's answer, recorded on its own source. companion/internal/server/contract_test.go sends these requests to the Companion of today and checks it still answers what the old app reads; app/src/contract.test.ts gives the app of today these answers and checks it reads them, and sends only these requests. {token}, {code}, {etag}, {before} and {confirmation} are filled in from the answers before them, and {home} and {box} in reads are the folders of this computer and of the other machine; a socket's send and its answer's text are the bytes, in base64. The answers name the fixture's home /Users/sam.",
  "calls": [
    {
      "name": "pair",
      "from": "link.ts pairWith",
      "method": "POST",
      "path": "/api/pair",
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "code": "{code}",
        "device": "Pixel"
      },
      "reads": [
        "token:string",
        "device:string",
        "name:string"
      ],
      "answer": {
        "status": 200,
        "body": {
          "device": "32efabee",
          "name": "studio",
          "token": "contract-token"
        }
      }
    },
    {
      "name": "info",
      "from": "link.ts companionVersion, updates.ts Updates.refresh (readInfo)",
      "method": "GET",
      "path": "/api/info",
      "reads": [
        "version:string",
        "latest:string",
        "canUpdate:boolean",
        "autoUpdate:boolean",
        "checks:string=ask|on|off",
        "app.url:string",
        "app.digest:string",
        "app.bytes:number",
        "plainUntil:time"
      ],
      "answer": {
        "status": 200,
        "body": {
          "app": {
            "bytes": 5,
            "digest": "sha256:ab",
            "url": "https://example.com/a.apk"
          },
          "autoUpdate": false,
          "canUpdate": true,
          "checks": "ask",
          "hc": "hc 0.1.20",
          "latest": "0.3.12",
          "name": "studio",
          "plainUntil": "2026-12-01T12:00:00Z",
          "version": "0.3.11"
        }
      }
    },
