diff --git a/crates/nsh-platform-android/java/com/longbridge/nsh/TextLayouts.java b/crates/nsh-platform-android/java/com/longbridge/nsh/TextLayouts.java
--- a/crates/nsh-platform-android/java/com/longbridge/nsh/TextLayouts.java
+++ b/crates/nsh-platform-android/java/com/longbridge/nsh/TextLayouts.java
@@ -224,6 +224,15 @@ final class TextLayouts {
                     .setBreakStrategy(Layout.BREAK_STRATEGY_SIMPLE)
                     .setHyphenationFrequency(Layout.HYPHENATION_FREQUENCY_NONE);
             if (justify) b.setJustificationMode(Layout.JUSTIFICATION_MODE_INTER_WORD);
+            if (android.os.Build.VERSION.SDK_INT >= 35) {
+                // Builders come from a pool, and `obtain` leaves these two as
+                // the last user set them: after a TextView that breaks by
+                // glyph bounds (an EditText on Android 15), lines here would
+                // too, while `desired()` and `measure` count advances, and
+                // text measured as one line breaks into a second the box
+                // cuts off.
+                b.setUseBoundsForWidth(false).setShiftDrawingOffsetForStartOverhang(false);
+            }
             if (maxLines > 0) {
                 b.setMaxLines(maxLines);
                 if (ellipsize != null) b.setEllipsize(ellipsize);
