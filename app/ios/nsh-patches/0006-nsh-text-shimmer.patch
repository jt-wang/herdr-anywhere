+        ),
+        (
+            Op::SetProp {
+                id: 2,
+                prop: Prop::ShimmerColor(None),
+            },
+            Color(0x424242ff),
+        ),
+        (
+            style_op(2, &[("color", StyleValue::Str("#929292"))]),
+            Color(0xb8b8b8ff),
+        ),
+    ] {
+        apply(&mut c, vec![op]);
+        let batch = c.commit().unwrap();
+        assert!(
+            batch
+                .items
+                .iter()
+                .any(|i| matches!(i, MountItem::ViewProps { id: 2, props }
+            if props.text_shimmer_color == Some(expected)))
+        );
+    }
+}
