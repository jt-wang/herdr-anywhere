+                    R.createRoot(() => {
+                        const m = R.createMemo(() => ({ n: 1 }));
+                        // A cycle: the value holds the memo's object.
+                        m().memo = m;
+                        globalThis.weak = new WeakRef(m());
+                    });
+                    "#,
+                )
+                .unwrap();
+        });
+        rt.run_gc();
+        let kept: bool = cx.with(|cx| cx.eval("globalThis.weak.deref()?.n === 1").unwrap());
