+    impl StackDelegate {
+        /// A swipe back began: end editing on the page it takes away, so the
+        /// keyboard hides while the finger is still down. Not when the swipe
+        /// asks to begin: work that holds the main thread there (resigning a
+        /// web view's editor, and what the keyboard leaving brings) runs
+        /// before the swipe begins, which it then does from wherever the
+        /// finger has got to, and UIKit cancels a pop begun that far along
+        /// and let go without speed. Begun, the pop follows the finger from
+        /// where it started.
+        #[unsafe(method(nshBackBegan:))]
+        fn back_began(&self, recognizer: &UIGestureRecognizer) {
+            if recognizer.state() == UIGestureRecognizerState::Began
+                && let Some(view) = recognizer.view()
+                && let Some(editor) = first_responder(&view)
+            {
+                // The outgoing view stays attached until the pop ends.
+                self.ivars()
+                    .editor
+                    .replace(Some(Weak::from_retained(&editor)));
+                view.endEditing(true);
+            }
+        }
+    }
