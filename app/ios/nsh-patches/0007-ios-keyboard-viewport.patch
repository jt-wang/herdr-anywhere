+    /// The keyboard-avoiding scroll's viewport in window coordinates.
+    fn avoiding_viewport(&self) -> Option<(NodeId, CGRect)> {
+        if self.keyboard <= 0.0 {
+            return None;
+        }
+        let id = self.avoiding?;
+        let Slot {
+            native: Native::Scroll(scroll),
+            ..
+        } = self.slot(id)?
